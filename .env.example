# Copy to .env.local and fill in. Nothing here is required to run `npm run dev`.

# Canonical origin — used for metadata, sitemap.xml, robots.txt and OG images.
# Set this in Vercel once the domain is live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery. Until all three are set, submissions are logged to the
# server console in development and refused in production, so no visitor is
# told "sent" when nothing was. See src/lib/inquiry-delivery.ts.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
